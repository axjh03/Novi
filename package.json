{
  "name": "novi",
  "version": "0.2.2",
  "private": true,
  "description": "A quiet space to think. A local, bring-your-own-key AI desktop companion.",
  "author": {
    "name": "Novi",
    "email": "getnoviapp@outlook.com"
  },
  "main": "out/main/main.js",
  "scripts": {
    "fix": "node scripts/fix.mjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "web:setup": "npm --prefix webapp run setup",
    "web:dev": "npm --prefix webapp run dev",
    "test": "node --test tests/local-models.test.mjs && tsx --test tests/*.test.ts",
    "test:local-models": "node --test tests/local-models.test.mjs",
    "test:desktop": "npm run build && tsx scripts/smoke.ts",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux deb",
    "package:all": "npm run build && electron-builder -mwl",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/qrcode": "^1.5.6",
    "koffi": "^3.3.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.149",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "electron@41.10.7": true
  }
}
