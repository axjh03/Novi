# Supabase connection strings (Prisma)
# Transaction pooler URL (IPv4 port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection URL (port 5432, used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORTAL_ORIGIN="http://localhost:3000"
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_JWT_SECRET=""
ACCESS_ENCRYPTION_KEY=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
SEED_DEMO="false"
DEMO_PASSWORD=""

# Retired /api/v1 only (returns 410). Leave empty unless migrating old data.
JWT_SECRET=""
ENCRYPTION_MASTER_KEY=""
LICENSE_SERVER_SECRET=""
