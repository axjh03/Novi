{
  "name": "webapp",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-access.mjs next dev",
    "prebuild": "node scripts/run-access.mjs prisma generate",
    "build": "node scripts/run-access.mjs next build",
    "start": "node scripts/run-access.mjs next start",
    "lint": "eslint",
    "db:generate": "node scripts/run-access.mjs prisma generate",
    "db:migrate": "node scripts/run-access.mjs prisma migrate dev",
    "db:reset": "node scripts/run-access.mjs prisma migrate reset",
    "db:seed": "node scripts/run-access.mjs seed",
    "db:deploy": "node scripts/run-access.mjs prisma migrate deploy",
    "setup": "node scripts/setup-access.mjs",
    "typecheck": "tsc --noEmit",
    "test:access": "tsx --test tests/access.test.ts",
    "test:site": "node --import tsx --test tests/site.test.ts",
    "test:artifacts": "node --import tsx --test tests/artifacts.test.ts",
    "test:legacy": "node --import tsx --test tests/legacy-api.test.ts",
    "test:control": "node --import tsx --test tests/control-route.test.ts",
    "test:throttle": "node --import tsx --test tests/login-throttle.test.ts",
    "test:releases": "node --import tsx --test tests/release-routes.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed-access.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "prisma": "^6.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
