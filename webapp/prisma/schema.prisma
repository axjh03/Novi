datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Access control v2. Legacy tables below remain intact for explicit data migration.
model AccessAccount {
  id           String @id @default(cuid())
  username     String @unique
  name         String
  passwordHash String
  role         String // ADMIN | STANDALONE | CORP | SUBCORP | LICENSE
  status       String @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  parentId     String?
  parent       AccessAccount? @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     AccessAccount[] @relation("AccountTree")
  ownedLicenses AccessLicense[] @relation("LicenseOwner")
  license      AccessLicense? @relation("LicenseAccount")
  credentials  ManagedCredential[]
  sessions     AccessSession[]
  requests     LicenseRequest[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([parentId])
}

model AccessLicense {
  id        String @id @default(cuid())
  key       String @unique
  ownerId   String
  owner     AccessAccount @relation("LicenseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  accountId String? @unique
  account   AccessAccount? @relation("LicenseAccount", fields: [accountId], references: [id], onDelete: Restrict)
  status    String @default("ACTIVE") // ACTIVE | TERMINATED
  // CORE | PRO | ULTIMATE | LIFETIME (src/shared/plans.ts). The default only fills rows that existed
  // before plans; the API always sets the plan. Lifetime stores a far-future expiresAt.
  plan      String @default("ULTIMATE")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([ownerId])
}

model AccessSession {
  id          String @id @default(cuid())
  accountId   String
  account     AccessAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  audience    String // portal | desktop
  // Unique nullable slot is acquired atomically for desktop sessions only.
  activeSlot  String? @unique
  deviceId    String?
  deviceName  String?
  ipAddress   String?
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([accountId])
}

model ManagedCredential {
  id              String @id @default(cuid())
  ownerId         String
  owner           AccessAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  provider        String
  nickname        String
  model           String
  encryptedSecret String
  lastFour        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([ownerId])
}

model LicenseRequest {
  id        String @id @default(cuid())
  ownerId   String
  owner     AccessAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  quantity  Int
  duration  Int // 0 for Lifetime
  unit      String // DAYS | MONTHS | YEARS, or LIFETIME
  plan      String @default("ULTIMATE") // CORE | PRO | ULTIMATE | LIFETIME, the plan the licenses are issued on
  status    String @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}

model AccessAudit {
  id        String @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  createdAt DateTime @default(now())
}

model LoginThrottle {
  key       String @id
  count     Int @default(1)
  expiresAt DateTime
}

// ─── User ────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String

  // role: ADMIN = platform superadmin, CORP = corporation/sub-corp owner, INDIVIDUAL
  role         String   @default("INDIVIDUAL") // "ADMIN" | "CORP" | "INDIVIDUAL"

  memberships  Membership[]
  licenses     License[]    // licenses assigned to this user
  credentials  ApiCredential[]
  auditLogs    AuditLog[]   @relation("ActorLogs")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Organization ─────────────────────────────────────────────────────────────
model Organization {
  id                   String       @id @default(cuid())
  type                 String       @default("INDIVIDUAL") // "INDIVIDUAL" | "CORPORATION"
  name                 String

  parentOrganizationId String?
  parentOrganization   Organization? @relation("OrganizationTree", fields: [parentOrganizationId], references: [id], onDelete: Cascade)
  children             Organization[] @relation("OrganizationTree")

  memberships          Membership[]
  licenses             License[]
  credentials          ApiCredential[]
  orders               Order[]
  auditLogs            AuditLog[]   @relation("OrganizationLogs")
  devices              Device[]

  status               String       @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "INACTIVE"

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// ─── Membership ───────────────────────────────────────────────────────────────
model Membership {
  id             String       @id @default(cuid())

  userId         String
  organizationId String

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role           String       @default("OWNER") // "OWNER" | "ADMIN" | "MEMBER"

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

// ─── License ──────────────────────────────────────────────────────────────────
// Licenses are created by admin and assigned to an organization (corp or indv).
// When a user activates a license, userId is set. A license can only be used by 1 user.
model License {
  id              String       @id @default(cuid())

  // Assigned-to organization (corp/indv/sub-corp)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Activated by user (set when first activated)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  licenseHash     String       @unique
  keyMasked       String       // e.g. NVI-7K4M-****-****-DM73

  status          String       @default("UNACTIVATED") // "UNACTIVATED" | "ACTIVE" | "GRACE" | "EXPIRED" | "SUSPENDED" | "REVOKED"

  issuedAt        DateTime     @default(now())
  activatedAt     DateTime?
  expiresAt       DateTime
  graceUntil      DateTime?

  // For now 1 device per license (1:1 device binding)
  activationLimit Int          @default(1)

  activations     LicenseActivation[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ─── Device ───────────────────────────────────────────────────────────────────
model Device {
  id              String       @id @default(cuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String?
  platform        String?
  appVersion      String?
  fingerprintHash String

  firstSeenAt     DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())

  // Track which user last used this device
  lastUsedByUserId String?

  status          String       @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "BLOCKED"

  activations     LicenseActivation[]

  @@unique([organizationId, fingerprintHash])
}

// ─── LicenseActivation ────────────────────────────────────────────────────────
// 1 active activation per license (1 device at a time)
model LicenseActivation {
  id            String    @id @default(cuid())

  licenseId     String
  deviceId      String

  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  userId        String?   // which user is currently active on this activation

  deviceToken   String    @unique
  activatedAt   DateTime  @default(now())
  lastHeartbeat DateTime?
  deactivatedAt DateTime?

  @@unique([licenseId, deviceId])
}

// ─── ApiCredential ────────────────────────────────────────────────────────────
model ApiCredential {
  id              String        @id @default(cuid())

  provider        String        // "OPENAI", "ANTHROPIC", "GEMINI", "DEEPSEEK"
  label           String
  scope           String        @default("ORGANIZATION") // "PERSONAL" | "ORGANIZATION"

  encryptedSecret String

  organizationId  String?
  userId          String?

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ─── Order ────────────────────────────────────────────────────────────────────
model Order {
  id             String       @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productName    String
  amount         Float
  currency       String       @default("USD")
  paymentMethod  String       @default("MANUAL")
  status         String       @default("COMPLETED")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─── AuditLog ────────────────────────────────────────────────────────────────
model AuditLog {
  id             String        @id @default(cuid())

  actorId        String?
  actor          User?         @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation("OrganizationLogs", fields: [organizationId], references: [id], onDelete: SetNull)

  action         String
  details        String?
  ipAddress      String?

  createdAt      DateTime      @default(now())
}
