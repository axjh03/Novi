# Desktop access server configuration.
# By default, the desktop app automatically detects its environment:
#   - Local dev / tests: defaults to http://localhost:3000
#   - Packaged production app: defaults to your hosted Vercel backend
#
# Optional overrides:
# NOVI_ACCESS_URL="http://localhost:3000"
# NOVI_PRODUCTION_ACCESS_URL="https://novi-virid.vercel.app"
